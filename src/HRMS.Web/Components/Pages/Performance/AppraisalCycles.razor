@page "/appraisal-cycles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,HR Manager")]
@using HRMS.Application.Performance
@using HRMS.Application.Common.Interfaces
@using HRMS.Domain.Entities.Organization
@using HRMS.Domain.Enums
@inject IAppraisalCycleService AppraisalCycleService
@inject IUnitOfWork UnitOfWork
@rendermode InteractiveServer

<PageTitle>Siklus Penilaian</PageTitle>

<h1>Siklus Penilaian Kinerja</h1>

<div class="row">
    <div class="col-md-7">
        @if (_cycles is null)
        {
            <p><em>Memuat...</em></p>
        }
        else if (_cycles.Count == 0)
        {
            <p class="text-muted">Belum ada siklus penilaian.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead><tr><th>Nama</th><th>Periode</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in _cycles)
                    {
                        <tr>
                            <td><a href="/appraisal-cycles/@c.Id">@c.Name</a></td>
                            <td>@c.StartDate.ToString("dd MMM yyyy") - @c.EndDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-@StatusBadge(c.Status)">@c.Status</span></td>
                            <td>
                                @if (c.Status == AppraisalCycleStatus.Draft)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => Activate(c.Id)">Aktifkan</button>
                                }
                                else if (c.Status == AppraisalCycleStatus.Active)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Complete(c.Id)">Selesaikan</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-5">
        <h5>Buat Siklus Baru</h5>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        @if (_companies is not null)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <div class="mb-2">
                    <label class="form-label">Nama Siklus</label>
                    <InputText class="form-control" @bind-Value="_model.Name" placeholder="mis. Semester 1 2026" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Perusahaan</label>
                    <InputSelect class="form-select" @bind-Value="_model.CompanyId">
                        <option value="">-- Pilih --</option>
                        @foreach (var c in _companies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-2">
                    <label class="form-label">Tanggal Mulai</label>
                    <InputDate class="form-control" @bind-Value="_model.StartDate" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Tanggal Selesai</label>
                    <InputDate class="form-control" @bind-Value="_model.EndDate" />
                </div>
                <button class="btn btn-primary" type="submit" disabled="@_isSaving">Buat Siklus</button>
            </EditForm>
        }
    </div>
</div>

@code {
    private List<AppraisalCycleDto>? _cycles;
    private List<Company>? _companies;
    private string? _errorMessage;
    private bool _isSaving;
    private readonly FormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _companies = await UnitOfWork.Repository<Company>().GetAllAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _cycles = await AppraisalCycleService.GetAllAsync();

    private async Task HandleSubmit()
    {
        _isSaving = true;
        _errorMessage = null;

        if (!Guid.TryParse(_model.CompanyId, out var companyId))
        {
            _errorMessage = "Pilih perusahaan terlebih dahulu.";
            _isSaving = false;
            return;
        }

        var request = new CreateAppraisalCycleRequest(
            _model.Name, companyId, DateOnly.FromDateTime(_model.StartDate), DateOnly.FromDateTime(_model.EndDate));
        var result = await AppraisalCycleService.CreateAsync(request);

        if (result.Succeeded)
        {
            _model.Name = string.Empty;
            await LoadAsync();
        }
        else
        {
            _errorMessage = string.Join(" ", result.Errors);
        }

        _isSaving = false;
    }

    private async Task Activate(Guid id)
    {
        await AppraisalCycleService.ActivateAsync(id);
        await LoadAsync();
    }

    private async Task Complete(Guid id)
    {
        await AppraisalCycleService.CompleteAsync(id);
        await LoadAsync();
    }

    private static string StatusBadge(AppraisalCycleStatus status) => status switch
    {
        AppraisalCycleStatus.Active => "success",
        AppraisalCycleStatus.Completed => "secondary",
        _ => "warning"
    };

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string CompanyId { get; set; } = string.Empty;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(6);
    }
}
