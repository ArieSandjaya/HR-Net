                                <span class="bi bi-bullseye-nav-menu" aria-hidden="true"></span> KRA
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-item px-3 mt-3">
                    <span class="nav-link text-white-50">@context.User.FindFirst("FullName")?.Value</span>
                </div>
