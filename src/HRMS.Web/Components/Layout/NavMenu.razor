                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="attendance">
                        <span class="bi bi-list-check-nav-menu" aria-hidden="true"></span> Rekap Absensi
                    </NavLink>
                </div>
                <AuthorizeView Roles="Administrator,HR Manager" Context="innerContext">
